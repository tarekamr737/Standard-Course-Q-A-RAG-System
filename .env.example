# Copy this file to .env and set your OpenRouter key locally. Never commit .env.
OPENROUTER_API_KEY=
OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
OPENROUTER_CHAT_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional: comma-separated backup model IDs for automatic OpenRouter failover.
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_SITE_URL=http://localhost:8501
OPENROUTER_APP_NAME=CourseGround
COURSEGROUND_TOP_K=4
COURSEGROUND_CHUNK_SIZE=900
COURSEGROUND_CHUNK_OVERLAP=160
COURSEGROUND_MIN_RELEVANCE=0.18
